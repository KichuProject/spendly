# ==================== DATABASE ====================
# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
# Get from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://spend_user:your_password@cluster.mongodb.net/spendapp?retryWrites=true&w=majority

# ==================== AUTHENTICATION ====================
# JWT Secret (min 32 characters for security)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long!

# ==================== EMAIL SERVICE (BREVO/SENDINBLUE) ====================
# Brevo API Key for sending emails (OTP, password reset, keep-alive)
# Get from Brevo Dashboard → Settings → SMTP & API
BREVO_API_KEY=xkeysib-abcd1234efgh5678ijkl9012mnop3456

# Sender email address (must be verified in Brevo)
# This email will be used for all outgoing emails
BREVO_SENDER_EMAIL=noreply@spendapp.com

# ==================== PUSH NOTIFICATIONS (EXPO) ====================
# Expo Push API endpoint (fixed URL)
# Documentation: https://docs.expo.dev/push-notifications/overview/
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ==================== SCHEDULING ====================
# Timezone for cron jobs (IANA format)
# Examples: Asia/Kolkata, America/New_York, Europe/London, Asia/Tokyo
# Jobs run at:
#   - 10 PM (22:00) - First push notification reminder
#   - 11 PM (23:00) - Second push notification reminder
#   - 02:00 on 1st & 15th - Brevo keep-alive email
CRON_TIMEZONE=Asia/Kolkata

# ==================== SERVER ====================
# Port number (use 5000 for local, Render sets PORT automatically)
PORT=5000

# Node environment
# Values: development | production
NODE_ENV=production

# Frontend URL (for CORS configuration)
FRONTEND_URL=https://spendly.com

# ==================== OPTIONAL ====================
# Log level (not currently implemented)
# LOG_LEVEL=info

# API Rate Limiting (not currently implemented)
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100

# ==================== AI SERVICES ====================
# NVIDIA API Key for Voice Transactions
# Get from build.nvidia.com
NVIDIA_API_KEY=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
